// DRV8833 dual H-bridge motor driver module, simplified: the board and
// its two rows of six pins.
// https://www.ti.com/product/DRV8833
// Draft for the circuit example; the electronics library replaces it.

// @pin IN1  [1.27, 1.27, 1.6]  input 5.75V
// @pin IN2  [3.81, 1.27, 1.6]  input 5.75V
// @pin IN3  [6.35, 1.27, 1.6]  input 5.75V
// @pin IN4  [8.89, 1.27, 1.6]  input 5.75V
// @pin VCC  [11.43, 1.27, 1.6] power_in 10.8V "motor supply"
// @pin GND  [13.97, 1.27, 1.6] ground
// @pin EEP  [1.27, 15.3, 1.6]  input 5.75V "sleep: high to run"
// @pin OUT1 [3.81, 15.3, 1.6]  output 10.8V
// @pin OUT2 [6.35, 15.3, 1.6]  output 10.8V
// @pin OUT3 [8.89, 15.3, 1.6]  output 10.8V
// @pin OUT4 [11.43, 15.3, 1.6] output 10.8V
// @pin ULT  [13.97, 15.3, 1.6] output 5.75V "fault"

color("FireBrick") cube([15.2, 16.6, 1.6]);
color("Black") translate([5, 6, 1.6]) cube([5, 4.4, 1]);
