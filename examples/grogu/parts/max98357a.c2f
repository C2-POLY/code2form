// Adafruit MAX98357A I2S class-D amplifier breakout, simplified: the
// board, the speaker terminal on the far edge, and its header if soldered.
// https://learn.adafruit.com/adafruit-max98357-i2s-class-d-mono-amp
// Draft for the circuit example; the electronics library replaces it.

/* [Build] */
// A header soldered under the board.
headers = false;

// @pin LRC  [1.28, 1.27, 1.6]  input 5.5V "word select"
// @pin BCLK [3.82, 1.27, 1.6]  input 5.5V "bit clock"
// @pin DIN  [6.36, 1.27, 1.6]  input 5.5V "data"
// @pin GAIN [8.9, 1.27, 1.6]   input 5.5V
// @pin SD   [11.44, 1.27, 1.6] input 5.5V "shutdown and channel"
// @pin GND  [13.98, 1.27, 1.6] ground
// @pin VIN  [16.52, 1.27, 1.6] power_in 5.5V
// @pin +    [6.4, 16.5, 1.6]   output 5.5V "speaker +"
// @pin -    [11.4, 16.5, 1.6]  output 5.5V "speaker -"

color("MidnightBlue") cube([17.8, 19.1, 1.6]);
color("Black") translate([4.4, 6, 1.6]) cube([3, 3, 0.9]);
color("LimeGreen") translate([3.9, 14, 1.6]) cube([10, 5, 6]);
if (headers)
    color("Black") translate([0, 0, -2.5]) cube([17.8, 2.54, 2.5]);
