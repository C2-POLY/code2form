// Small DC motor (130 size) lying along x, its shaft towards +x, simplified.
// Draft for the circuit example; the electronics library replaces it.

// @pin + [0, -4, 7.5] -x passive
// @pin - [0, 4, 7.5]  -x passive
// @port shaft [25, 0, 7.5] +x d=2.5

$fn = 48;
color("Silver") translate([0, 0, 7.5]) rotate([0, 90, 0]) cylinder(d = 15, h = 25);
color("Silver") translate([25, 0, 7.5]) rotate([0, 90, 0]) cylinder(d = 2, h = 8);
