// Seeed Studio XIAO ESP32-S3, simplified: the board, its shield and its
// USB-C connector, seen from above with the USB-C port towards +y.
// https://wiki.seeedstudio.com/xiao_esp32s3_getting_started/
// Draft for the circuit example; the electronics library replaces it.

// @pin D0  [1.28, 18.12, 1.2] io 3.3V "GPIO1, A0, touch"
// @pin D1  [1.28, 15.58, 1.2] io 3.3V "GPIO2, A1"
// @pin D2  [1.28, 13.04, 1.2] io 3.3V reserved "GPIO3, A2, strapping"
// @pin D3  [1.28, 10.5, 1.2]  io 3.3V "GPIO4, A3"
// @pin D4  [1.28, 7.96, 1.2]  io 3.3V "GPIO5, SDA"
// @pin D5  [1.28, 5.42, 1.2]  io 3.3V "GPIO6, SCL"
// @pin D6  [1.28, 2.88, 1.2]  io 3.3V "GPIO43, TX"
// @pin 5V  [16.52, 18.12, 1.2] power_out 5V "USB 5 V"
// @pin GND [16.52, 15.58, 1.2] ground
// @pin 3V3 [16.52, 13.04, 1.2] power_out 3.3V
// @pin D10 [16.52, 10.5, 1.2] io 3.3V "GPIO9, MOSI"
// @pin D9  [16.52, 7.96, 1.2] io 3.3V "GPIO8, MISO"
// @pin D8  [16.52, 5.42, 1.2] io 3.3V "GPIO7, SCK"
// @pin D7  [16.52, 2.88, 1.2] io 3.3V "GPIO44, RX"
// @port usb_c [8.9, 21, 2.8] +y [9, 3.2] "USB-C"

color("RoyalBlue") cube([17.8, 21, 1.2]);
color("Silver") translate([3, 2, 1.2]) cube([11.8, 14, 2.4]);
color("Silver") translate([4.4, 14.5, 1.2]) cube([9, 7, 3.2]);
