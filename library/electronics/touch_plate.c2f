// Copper plate for a capacitive touch pad, as it looks in the hand: a
// square of bare copper sheet (or copper tape on card), its corners
// trimmed round, tinned at one corner where a blob of solder holds the
// wire to a touch pin of the ESP32-S3. Glued under a thin shell. Its
// corner at the origin.
// https://docs.espressif.com/projects/esp-idf/en/latest/esp32s3/api-reference/peripherals/cap_touch_sens.html
//
// No part number: the size is the designer's. Espressif's touch sensor
// guide covers how pad size, the plastic over it and the wire's length
// change the reading: a larger pad reaches through more plastic, a short
// wire picks up less noise. Estimated: the tinned patch (4 mm across) and
// the solder blob on it (2.6 mm across, 0.6 mm high), as a careful hand
// leaves them.
//
// Annotations are plain numbers: the solder point stays in its corner
// whatever the size, at the default sheet's top.

/* [Size] */
// Side of the square.
size = 20; // [10:50]
// Thickness of the sheet.
thickness = 0.3; // [0.05:0.05:1]

// @pin PAD [2, 2, 0.3] up passive 3.3V "solder point"

module touch_plate(size = 20, thickness = 0.3) {
    $fn = 24;
    copper = [0.80, 0.47, 0.30];
    tin = [0.78, 0.79, 0.80];
    solder = [0.86, 0.87, 0.88];

    // The sheet, its corners trimmed so they don't catch.
    color(copper) hull() for (x = [1, size - 1], y = [1, size - 1])
        translate([x, y, 0]) cylinder(r = 1, h = thickness);
    // The tinned patch at the corner and the blob of solder on it.
    color(tin) translate([2, 2, thickness]) cylinder(d = 4, h = 0.02);
    color(solder) translate([2, 2, thickness]) scale([1, 1, 0.6 / 1.3]) intersection() {
        sphere(d = 2.6);
        translate([0, 0, 1.5]) cube(3, center = true);
    }
}

touch_plate(size, thickness);
